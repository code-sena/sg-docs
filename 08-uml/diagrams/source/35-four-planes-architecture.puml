@startuml
 title Four-plane architecture
top to bottom direction
package "plane of clients" {
  component "web Angular SPA/SSR" as web
  component "mobile Expo/React Native" as MOV
}
package "plane of edge" {
  component "Kong API Gateway :8000" as KONG
}
package "plane of domain" {
  component "ms-iam :8080" as IAM
  component "ms-user-management :8080" as UM
  component "ms-school-management :8080 + gRPC :5001" as SCH
  component "ms-fleet :8080" as FLT
  component "ms-route :8080 + gRPC" as ROUTE
  component "ms-notification :8080" as NOT
  component "ms-forgot-information :8080" as FOR
  component "ms-configuration :8080" as CFG
  component "ms-exceptional :8080" as EX
  component "gps-backend :8080 / TCP :8842" as GPS
}
package "plane of infrastructure" {
  queue "Kafka :9092" as KAF
  database "SQL Server 2022 :1433" as SQL
}
web --> KONG
MOV --> KONG
KONG --> IAM
KONG --> UM
KONG --> SCH
KONG --> FLT
KONG --> ROUTE
KONG --> NOT
KONG --> FOR
UM --> SCH
FLT --> UM
ROUTE --> FLT
NOT --> UM
NOT --> ROUTE
FOR --> IAM
IAM <--> KAF
UM <--> KAF
NOT <--> KAF
IAM --> SQL
UM --> SQL
SCH --> SQL
FLT --> SQL
ROUTE --> SQL
NOT --> SQL
CFG --> SQL
EX --> SQL
@enduml

