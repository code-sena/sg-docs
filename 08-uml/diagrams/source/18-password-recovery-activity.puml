@startuml
 title Password recovery
start
:user requests recovery;
:enters email recorded;
if (¿account and medio coinciden?) then (yes)
  :generate code of a solo use and expiración;
  :send code per email or SMS;
  :user enters code;
  if (¿code valid and vigente?) then (yes)
    repeat
      :user defines password new;
    repeat while (¿Incumple política?) is (yes)
    :update hash;
    :Invalidar tokens active;
    :Redirigir al start of session;
  else (not)
    :Limitar retries and block request;
  endif
else (not)
  :show message genérico;
endif
stop
@enduml

